# Database Configuration
DATABASE_URL=sqlite:///./asset_copilot.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/asset_copilot

# Dataset Directory Path
DATASET_DIR=./sample-data/sample-data
REFERENCE_DATE=2026-10-16

# AI Configuration (Optional - Tool-Calling Agent works deterministically out-of-the-box)
AI_PROVIDER=auto # auto, gemini, openai, ollama, deterministic
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000
